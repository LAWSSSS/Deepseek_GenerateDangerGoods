{
  "Task": {
    "$defs": {
      "Region": {
        "additionalProperties": false,
        "properties": {
          "label": {
            "maxLength": 64,
            "minLength": 1,
            "title": "Label",
            "type": "string"
          },
          "polygon": {
            "items": {
              "maxItems": 2,
              "minItems": 2,
              "prefixItems": [
                {
                  "maximum": 1,
                  "minimum": 0,
                  "type": "number"
                },
                {
                  "maximum": 1,
                  "minimum": 0,
                  "type": "number"
                }
              ],
              "type": "array"
            },
            "maxItems": 80,
            "minItems": 3,
            "title": "Polygon",
            "type": "array"
          },
          "feather_px": {
            "default": 8,
            "maximum": 64,
            "minimum": 0,
            "title": "Feather Px",
            "type": "number"
          }
        },
        "required": [
          "label",
          "polygon"
        ],
        "title": "Region",
        "type": "object"
      }
    },
    "additionalProperties": false,
    "properties": {
      "source": {
        "maxLength": 500,
        "minLength": 1,
        "title": "Source",
        "type": "string"
      },
      "instruction": {
        "maxLength": 1200,
        "minLength": 1,
        "title": "Instruction",
        "type": "string"
      },
      "targets": {
        "maxProperties": 6,
        "minProperties": 1,
        "patternProperties": {
          "^[a-zA-Z0-9_-]{1,32}$": {
            "$ref": "#/$defs/Region"
          }
        },
        "title": "Targets",
        "type": "object"
      },
      "allowed_ops": {
        "items": {
          "enum": [
            "brightness",
            "warmth",
            "saturation",
            "blur_px"
          ],
          "type": "string"
        },
        "maxItems": 4,
        "minItems": 1,
        "title": "Allowed Ops",
        "type": "array"
      },
      "limits": {
        "additionalProperties": {
          "maxItems": 2,
          "minItems": 2,
          "prefixItems": [
            {
              "type": "number"
            },
            {
              "type": "number"
            }
          ],
          "type": "array"
        },
        "propertyNames": {
          "enum": [
            "brightness",
            "warmth",
            "saturation",
            "blur_px"
          ]
        },
        "title": "Limits",
        "type": "object"
      },
      "group": {
        "anyOf": [
          {
            "maxLength": 128,
            "type": "string"
          },
          {
            "type": "null"
          }
        ],
        "default": null,
        "title": "Group"
      },
      "hide_groups": {
        "items": {
          "type": "string"
        },
        "maxItems": 12,
        "title": "Hide Groups",
        "type": "array"
      },
      "max_trials": {
        "default": 2,
        "maximum": 4,
        "minimum": 1,
        "title": "Max Trials",
        "type": "integer"
      },
      "target_score": {
        "default": 85,
        "maximum": 100,
        "minimum": 0,
        "title": "Target Score",
        "type": "integer"
      },
      "min_gain": {
        "default": 4,
        "maximum": 20,
        "minimum": 1,
        "title": "Min Gain",
        "type": "integer"
      },
      "preview_edge": {
        "default": 640,
        "maximum": 896,
        "minimum": 320,
        "title": "Preview Edge",
        "type": "integer"
      },
      "preview_rect": {
        "anyOf": [
          {
            "maxItems": 4,
            "minItems": 4,
            "prefixItems": [
              {
                "maximum": 1,
                "minimum": 0,
                "type": "number"
              },
              {
                "maximum": 1,
                "minimum": 0,
                "type": "number"
              },
              {
                "maximum": 1,
                "minimum": 0,
                "type": "number"
              },
              {
                "maximum": 1,
                "minimum": 0,
                "type": "number"
              }
            ],
            "type": "array"
          },
          {
            "type": "null"
          }
        ],
        "default": null,
        "title": "Preview Rect"
      }
    },
    "required": [
      "source",
      "instruction",
      "targets",
      "allowed_ops"
    ],
    "title": "Task",
    "type": "object"
  },
  "Config": {
    "$defs": {
      "Endpoint": {
        "additionalProperties": false,
        "properties": {
          "url": {
            "maxLength": 500,
            "title": "Url",
            "type": "string"
          },
          "model": {
            "maxLength": 120,
            "minLength": 1,
            "title": "Model",
            "type": "string"
          },
          "key_env": {
            "anyOf": [
              {
                "pattern": "^[A-Za-z_][A-Za-z0-9_]*$",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Key Env"
          },
          "json_mode": {
            "default": true,
            "title": "Json Mode",
            "type": "boolean"
          },
          "token_field": {
            "default": "max_tokens",
            "enum": [
              "max_tokens",
              "max_completion_tokens"
            ],
            "title": "Token Field",
            "type": "string"
          },
          "max_output_tokens": {
            "default": 384,
            "maximum": 1024,
            "minimum": 128,
            "title": "Max Output Tokens",
            "type": "integer"
          },
          "timeout_seconds": {
            "default": 45,
            "maximum": 120,
            "minimum": 5,
            "title": "Timeout Seconds",
            "type": "integer"
          },
          "reasoning_effort": {
            "anyOf": [
              {
                "enum": [
                  "none",
                  "low",
                  "medium",
                  "high",
                  "max"
                ],
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Reasoning Effort"
          }
        },
        "required": [
          "url",
          "model"
        ],
        "title": "Endpoint",
        "type": "object"
      }
    },
    "additionalProperties": false,
    "properties": {
      "planner": {
        "anyOf": [
          {
            "$ref": "#/$defs/Endpoint"
          },
          {
            "type": "null"
          }
        ],
        "default": null
      },
      "vision": {
        "anyOf": [
          {
            "$ref": "#/$defs/Endpoint"
          },
          {
            "type": "null"
          }
        ],
        "default": null
      }
    },
    "title": "Config",
    "type": "object"
  },
  "Plan": {
